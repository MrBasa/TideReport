#!/usr/bin/env fish
if set -q TIDE_REPORT_TEST_GH_SLEEP_SECONDS
    sleep $TIDE_REPORT_TEST_GH_SLEEP_SECONDS
end

if contains -- auth $argv; and contains -- status $argv
    if set -q TIDE_REPORT_TEST_GH_AUTH_FAIL
        exit 1
    end
    printf '%s\n' "github.com"
    printf '%s\n' "  ✓ Logged in to github.com account test (keyring)"
    exit 0
end

set -l response "$TIDE_REPORT_TEST_GH_RESPONSE"
set -l st 0
if set -q TIDE_REPORT_TEST_GH_STATUS
    set st $TIDE_REPORT_TEST_GH_STATUS
end
if test -n "$response"; and test -f "$response"
    cat "$response"
else
    printf '%s' "$response"
end
exit $st
